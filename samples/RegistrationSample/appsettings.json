{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Consul": {
    "Agent": {
      "Datacenter": "dc1",
      "Address": "http://localhost:8500",
      "WaitTime": "00:00:05"
    },
    "Configuration": {
      "PathBase": "samples/RegistrationSample",
      "Namespace": "public1",
      "Sets": [
        {
          "Id": "config.json",
          "Group": "group1",
          "Optional": false,
          "ReloadOnChange": true,
          "PollingWaitTime": "00:00:10",
          "IgnoreException": true
        }
      ],
      "Metadata": {
        "MyKey1": "MyValue1"
      }
    },
    "Registration": {
      "Name": "RegistrationSample",
      "Version": "1.0.0",
      "Metadata": {
      }
    }
  }
}
