<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
	<TargetFrameworks>net10.0;net8.0</TargetFrameworks>
	<Version>1.4.0</Version>	
	<PackageTags>Consul;Configuration;Service-Discovery</PackageTags>
	<Description>Alastack.Consul supports Configuration and Service Discovery with Hashicorp Consul.</Description>
	
  </PropertyGroup>

  <ItemGroup>
	<InternalsVisibleTo Include="Alastack.Consul.Tests" />
  </ItemGroup>

	<ItemGroup>
		<PackageReference Include="Consul" />
	</ItemGroup>
	<ItemGroup Condition="'$(TargetFramework)'=='net10.0'">
		<PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
		<PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
    </ItemGroup>
	<ItemGroup Condition="'$(TargetFramework)'=='net8.0'">
		<PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
		<PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
	</ItemGroup>  

	<ItemGroup>
		<ProjectReference Include="..\Alastack.Extensions.Configuration.Consul\Alastack.Extensions.Configuration.Consul.csproj" />
	</ItemGroup>
</Project>
